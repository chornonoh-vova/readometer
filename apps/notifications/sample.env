NODE_ENV="development"

PORT=3001

# Deadline for draining in-flight jobs on SIGTERM before the process force-exits.
# Keep it below the orchestrator's stop grace period (Docker defaults to 10s), or
# the process is SIGKILLed mid-drain. Defaults to 8000.
SHUTDOWN_TIMEOUT_MS=8000

REDIS_URL=redis://user:password@host:6379/0
SMTP_HOST=<smtp host>
SMTP_PORT=<smtp port>
SMTP_SECURE=<boolean>
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>
MAIL_FROM=noreply@mail.readometer.local

