{
  "name": "api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:migrate": "kysely migrate",
    "db:generate": "kysely-codegen --out-file ./src/lib/db.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@better-auth/redis-storage": "catalog:",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "hono": "^4.12.32",
    "ioredis": "catalog:",
    "isbn": "workspace:*",
    "kysely": "^0.29.4",
    "notification-events": "workspace:*",
    "pg": "^8.22.0",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "prettier": "catalog:",
    "testcontainers": "^12.0.1",
    "vitest": "catalog:"
  }
}
