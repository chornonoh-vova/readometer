{
  "name": "api",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:migrate": "kysely migrate",
    "db:generate": "kysely-codegen --out-file ./src/lib/db.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ban:user": "bun run scripts/ban-user.ts",
    "purge:bots": "bun run scripts/purge-bot-accounts.ts",
    "purge:banned": "bun run scripts/purge-banned-data.ts",
    "sweep:covers": "bun run scripts/sweep-orphan-covers.ts"
  },
  "dependencies": {
    "@better-auth/redis-storage": "catalog:",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "disposable-email-domains-js": "^1.25.0",
    "hono": "^4.13.7",
    "ioredis": "catalog:",
    "isbn": "workspace:*",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "notification-events": "workspace:*",
    "pg": "^8.23.0",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config": "workspace:*",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "testcontainers": "^12.0.1",
    "typescript": "catalog:",
    "typescript-config": "workspace:*",
    "vitest": "catalog:"
  }
}
