NODE_ENV="development"

PORT=3000

# Deadline for draining in-flight work on SIGTERM before the process force-exits.
# Keep it below the orchestrator's stop grace period (Docker defaults to 10s), or
# the process is SIGKILLed mid-drain. Defaults to 8000.
SHUTDOWN_TIMEOUT_MS=8000

BETTER_AUTH_SECRET='<better-auth-secret>'
BETTER_AUTH_URL=http://localhost:5173

TRUSTED_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://user:password@host:5432/database

REDIS_URL=redis://user:password@host:6379/0

# Dummy turnstile secret key that always passes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

GOOGLE_CLIENT_ID='<google-client-id>'
GOOGLE_CLIENT_SECRET='<google-client-secret>'

# Sign in with Apple. The api signs its own client secret from the key below, so
# there is no APPLE_CLIENT_SECRET. The return URL registered with Apple must be
# `<BETTER_AUTH_URL>/api/auth/callback/apple` over https - Apple rejects http and
# localhost, so this flow cannot be exercised against `bun run dev`.
#
# APPLE_CLIENT_ID is the Services ID, not the App ID or the bundle identifier;
# confusing them is the usual cause of a bare `invalid_client`.
# APPLE_PRIVATE_KEY is the AuthKey_<APPLE_KEY_ID>.p8 contents on one line with
# newlines written as \n - nothing in the deploy path carries a literal one.
# APPLE_APP_BUNDLE_IDENTIFIER is only read when verifying a native app's ID
# token; there is no such app, but auth.ts requires all five to be set.
APPLE_CLIENT_ID='<apple-services-id>'
APPLE_TEAM_ID='<apple-team-id>'
APPLE_KEY_ID='<apple-key-id>'
APPLE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n<base64-of-the-p8>\n-----END PRIVATE KEY-----'
APPLE_APP_BUNDLE_IDENTIFIER='<apple-app-bundle-id>'

# Last-resort kill switch for an ongoing bot campaign. Set to false to shut the
# email sign-up route entirely, leaving "Sign up with Google" and "Sign up with
# Apple" as the only ways to create an account. Accepts true/false/1/0 and
# refuses to start on anything else - a switch left open because someone wrote
# "no" is worse than a crash.
# Scoped to account creation: existing users can still sign in and reset their
# password, and the web form still renders, it just always fails.
# Defaults to true.
EMAIL_SIGNUP_ENABLED=true

# Score at or above which a sign-up is rejected as a bot. Lower is stricter.
# Read once at startup, so retuning it is a restart rather than a deploy.
# Defaults to 3, which is where the observed campaign sits - one of those bots
# scores exactly 3, so 4 stops catching it.
# 2 is the strict end: any single fuzzy signal (all-caps, a four-consonant run,
# a digit in the name) then rejects on its own. Do not use 1 - a lowercase
# single-word name scores 1, and real people type their names that way.
BOT_SCORE_THRESHOLD=3

STORAGE_PATH=storage
