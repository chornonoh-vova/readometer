{
  "$schema": "https://v2-10-10.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!sample.env",
        "!Dockerfile",
        "!nginx/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!sample.env",
        "!Dockerfile",
        "!nginx/**",
        ".env*"
      ],
      "outputs": ["dist/**", "*.tsbuildinfo"],
      "env": ["VITE_TURNSTILE_SITE_KEY"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!sample.env",
        "!Dockerfile",
        "!nginx/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!sample.env",
        "!Dockerfile",
        "!nginx/**"
      ],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!sample.env",
        "!Dockerfile",
        "!nginx/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
