{
  "name": "readometer",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "bun run dev:deps:up && bun run dev && bun run dev:deps:down",
    "dev:docker": "bun run dev:docker:build && bun run dev:docker:up && bun run dev:docker:down",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "fmt": "prettier . --write",
    "fmt:check": "prettier . --check",
    "test": "turbo run test",
    "dev:docker:build": "docker compose -f dev.compose.yaml build",
    "dev:docker:up": "docker compose -f dev.compose.yaml up",
    "dev:docker:down": "docker compose -f dev.compose.yaml down",
    "dev:deps:up": "docker compose -f deps.compose.yaml up -d",
    "dev:deps:down": "docker compose -f deps.compose.yaml down"
  },
  "catalog": {
    "zod": "^4.4.3",
    "better-auth": "^1.6.9",
    "@better-auth/redis-storage": "^1.6.9",
    "uuid": "^14.0.0",
    "vitest": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^6.0.3",
    "eslint": "^10.3.0",
    "@eslint/js": "10.0.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "bullmq": "^5.79.3",
    "ioredis": "5.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "6.7.0",
    "@react-email/ui": "6.7.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.8.3",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
